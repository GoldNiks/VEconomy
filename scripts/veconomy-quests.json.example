{
  // Сумма за квест в главах, не перечисленных ниже (0 = ничего)
  "defaultPerQuest": 0,
  // Название главы: сумма за один квест (название как в FTB Quests)
  // Чем дальше глава — тем больше ставь, нарастание получится само.
  "chapters": {
    "Глава 1": 100,
    "Глава 2": 200,
    "Глава 3": 400
  }
}
